{
  "name": "toyboot4e-devlog-builder",
  "private": true,
  "description": "Vite-based build for the devlog (uniorg render + tree-sitter/KaTeX bake, CSS modules).",
  "type": "module",
  "scripts": {
    "bundle": "vite build -c vite.build.config.ts",
    "build": "bun run bundle && bun dist/main.js",
    "assets": "ASSETS_CLI=1 bun src/assets.ts",
    "linkcards": "bun src/fetch-linkcards.ts",
    "watch": "vite-node src/watch.ts",
    "test": "vitest run",
    "test:update": "UPDATE_GOLDEN=1 vitest run",
    "fmt": "oxfmt",
    "fmt:browser": "cd .. && oxfmt -c builder/.oxfmtrc.json 'src/style/*.ts'",
    "fmt:check": "oxfmt --check && bun run fmt:browser --check",
    "lint": "oxlint && cd .. && oxlint -c builder/.oxlintrc.json src/style",
    "typecheck": "tsc -p . && tsc -p ../src/style",
    "check": "bun run css-types:check && bun run fmt:check && bun run lint && bun run typecheck",
    "css-types": "bun src/css-types.ts",
    "css-types:check": "bun src/css-types.ts --check"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "linkedom": "^0.18.14",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "unified": "^11.0.5",
    "uniorg-parse": "^3.2.2",
    "uniorg-rehype": "^2.2.0",
    "web-tree-sitter": "^0.27.1"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.5",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "rolldown": "~1.2.15",
    "typescript": "^7.0.2",
    "uniorg": "^1.4.0",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
