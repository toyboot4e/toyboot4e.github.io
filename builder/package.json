{
  "name": "toyboot4e-devlog-builder",
  "private": true,
  "type": "module",
  "description": "Vite-based build for the devlog (uniorg render + tree-sitter/KaTeX bake, CSS modules).",
  "scripts": {
    "bundle": "vite build -c vite.build.config.ts",
    "build": "bun run bundle && bun dist/main.js",
    "assets": "ASSETS_CLI=1 bun src/assets.ts",
    "linkcards": "bun src/fetch-linkcards.ts",
    "watch": "vite-node src/watch.ts",
    "test": "vitest run",
    "test:update": "UPDATE_GOLDEN=1 vitest run"
  },
  "dependencies": {
    "katex": "^0.16.0",
    "linkedom": "^0.18.0",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "unified": "^11.0.5",
    "uniorg-parse": "^3.2.2",
    "uniorg-rehype": "^2.2.0",
    "web-tree-sitter": "^0.26.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "vite": "^8.0.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
